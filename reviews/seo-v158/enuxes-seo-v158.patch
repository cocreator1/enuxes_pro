+ function settings(raw={}){if(raw==null)raw={};else if(typeof raw!=='object'||Array.isArray(raw))raw={indexable:false};return {title:text(raw.title,200),description:text(raw.description,500),image:https(raw.image),publicDescription:text(raw.publicDescription,1000),city:text(raw.city,80),region:text(raw.region,80),serviceArea:text(raw.serviceArea,200),contactModel:['online','service-area','premises'].includes(raw.contactModel)?raw.contactModel:'online',googleProfile:google(raw.googleProfile),indexable:raw.indexable===undefined?true:raw.indexable===true};}
