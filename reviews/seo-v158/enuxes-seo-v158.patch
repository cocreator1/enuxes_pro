+ function body(p,items,item){return '<article class="seo-document"><nav aria-label="Breadcrumb"><a href="/">eNuxes</a> / <a href="'+esc(p.url)+'">'+esc(p.name)+'</a></nav><h1>'+esc(item?text(item.name,160):p.name)+'</h1>'+(item?'<p>'+esc(text(item.description,2000))+'</p>'+(https(item.image_url)?'<img src="'+esc(https(item.image_url))+'" alt="'+esc(text(item.name,160))+'" width="640" height="480" loading="eager" fetchpriority="high">':'')+(price(item)!==null?'<p>N$'+esc(price(item))+(p.template==='accommodation'?' per night':'')+'</p>':''):'')+facts(p)+'<h2>'+(service(p)?'Services and rooms':'Products and menu')+'</h2>'+links(p,items)+'<p><a href="/'+esc(p.store.slug)+'">Open '+esc(p.name)+' storefront</a> · <a href="/discover">Discover businesses</a></p></article>';}
