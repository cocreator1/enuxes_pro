+ const price=item=>{const v=item.sale_price_minor??item.price_minor;return Number.isSafeInteger(v)&&v>=0?(v/100).toFixed(2):null;};
+ function graph(p,item){const entity={'@type':'Organization','@id':p.url+'#business',name:p.name,url:p.url,description:p.description||p.meta,image:p.image};if(p.seo.contactModel!=='online'){entity['@type']=({retail:'Store',accommodation:'LodgingBusiness',salon:'HealthAndBeautyBusiness',restaurant:'Restaurant',cafe:'CafeOrCoffeeShop',bar:'BarOrPub',professional:'ProfessionalService'})[p.template];if(p.seo.city||p.seo.region)entity.areaServed={'@type':'AdministrativeArea',name:p.location};}if(p.seo.googleProfile)entity.sameAs=[p.seo.googleProfile];const crumbs=[{name:'eNuxes',item:origin+'/'},{name:p.name,item:p.url}],nodes=[entity];if(item){const url=origin+itemPath(p,item),node={'@type':service(p)?'Service':'Product','@id':url+'#item',url,name:text(item.name,160),description:text(item.description,2000),...(https(item.image_url)?{image:https(item.image_url)}:{})};if(service(p))node.provider={'@id':entity['@id']};const amount=price(item);if(amount!==null){node.offers={'@type':'Offer',url,price:amount,priceCurrency:'NAD'};if(!service(p)&&Number.isSafeInteger(item.stock)&&item.stock>=0)node.offers.availability='https://schema.org/'+(item.stock>0?'InStock':'OutOfStock');}nodes.push(node);crumbs.push({name:node.name,item:url});}nodes.push({'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,...c}))});return {'@context':'https://schema.org','@graph':nodes};}
