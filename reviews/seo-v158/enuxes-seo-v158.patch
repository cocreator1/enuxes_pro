+ function profile(store,content=contentOf(store)){const seo=settings(content.merchandising?.seo),template=Object.hasOwn(templates,content.merchandising?.businessTemplate)?content.merchandising.businessTemplate:'retail',name=text(store.name,100)||'Business',category=text(content.category,80)||templates[template],location=[seo.city,seo.region].filter(Boolean).join(', '),description=seo.publicDescription||text(store.description,1000),url=origin+'/'+encodeURIComponent(store.slug);return {store:{id:store.id,slug:store.slug,name:store.name,active:store.active},content:{logo:content.logo},seo,template,name,category,location,description,url,title:seo.title||[name,category,location].filter(Boolean).join(' · '),meta:seo.description||description||[name,category,location].filter(Boolean).join(' · '),image:seo.image||https(content.logo)||origin+'/app-icons/storefront-512.png',eligible:store.active===true&&seo.indexable};}
